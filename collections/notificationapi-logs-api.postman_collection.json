                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "POST",
            "auth": null,
            "body": {
              "mode": "raw",
              "raw": "{\n  \"dateRangeFilter\": {\n    \"startTime\": \"<integer>\",\n    \"endTime\": \"<integer>\"\n  },\n  \"notificationFilter\": [\n    \"<string>\",\n    \"<string>\"\n  ],\n  \"channelFilter\": [\n    \"<string>\",\n    \"<string>\"\n  ],\n  \"userFilter\": [\n    \"<string>\",\n    \"<string>\"\n  ],\n  \"statusFilter\": [\n    \"<string>\",\n    \"<string>\"\n  ],\n  \"trackingIds\": [\n    \"<string>\",\n    \"<string>\"\n  ]\n}",
