        {
          "id": "58000511-f4e5-431b-ac00-6c39e7f34470",
          "name": "Set user preferences",
          "request": {
            "name": "Set user preferences",
            "description": {
              "content": "Sets per-notification, per-channel delivery preferences and opt-outs for a user. The body is an array of preference objects.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "user_preferences",
                ":userId"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [],
              "variable": [
                {
                  "disabled": false,
                  "type": "any",
                  "value": "<string>",
                  "key": "userId",
                  "description": "(Required) The ID of the user in your system."
                },
                {
                  "description": "Your NotificationAPI account clientId.",
                  "type": "any",
                  "value": "{{clientId}}",
                  "key": "clientId"
                }
              ]
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "method": "POST",
            "auth": null,
            "body": {
              "mode": "raw",
              "raw": "[\n  {\n    \"notificationId\": \"<string>\",\n    \"channel\": \"<string>\",\n    \"delivery\": \"<string>\",\n    \"subNotificationId\": \"<string>\"\n  },\n  {\n    \"notificationId\": \"<string>\",\n    \"channel\": \"<string>\",\n    \"delivery\": \"<string>\",\n    \"subNotificationId\": \"<string>\"\n  }\n]",
