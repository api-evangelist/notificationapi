          "name": "Delete stored preferences for a user",
          "request": {
            "name": "Delete stored preferences for a user",
            "description": {
              "content": "Deletes any stored preferences for a user and a given notificationId (optionally scoped to a subNotificationId).",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "users",
                ":userId",
                "preferences"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "notificationId",
                  "value": "<string>",
                  "description": "(Required) The notification whose stored preferences should be deleted."
                },
                {
                  "disabled": false,
                  "key": "subNotificationId",
                  "value": "<string>",
                  "description": "Optional subNotification scope."
                }
              ],
              "variable": [
                {
                  "disabled": false,
                  "type": "any",
                  "value": "<string>",
                  "key": "userId",
                  "description": "(Required) The ID of the user in your system."
                },
                {
                  "description": "Your NotificationAPI account clientId.",
