        {
          "id": "d39943b9-835f-4fa4-8112-b5a7047172a7",
          "name": "Update in-app notifications",
          "request": {
            "name": "Update in-app notifications",
            "description": {
              "content": "Marks one or more in-app notifications (by trackingId) as opened, clicked, archived, or actioned, or attaches a reply. Authenticated with the per-user HMAC Authorization header.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "users",
                ":userId",
                "notifications",
                "INAPP_WEB"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [],
              "variable": [
                {
                  "disabled": false,
                  "type": "any",
                  "value": "<string>",
                  "key": "userId",
                  "description": "(Required) The ID of the user in your system."
                },
                {
                  "description": "Your NotificationAPI account clientId.",
                  "type": "any",
                  "value": "{{clientId}}",
                  "key": "clientId"
                }
              ]
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "method": "PATCH",
            "auth": null,
            "body": {
              "mode": "raw",
              "raw": "{\n  \"trackingIds\": [\n    \"<string>\",\n    \"<string>\"\n  ],\n  \"opened\": \"<dateTime>\",\n  \"clicked\": \"<dateTime>\",\n  \"archived\": \"<dateTime>\",\n  \"actioned1\": \"<dateTime>\",\n  \"actioned2\": \"<dateTime>\",\n  \"reply\": {\n    \"date\": \"<dateTime>\",\n    \"message\": \"<string>\"\n  }\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
