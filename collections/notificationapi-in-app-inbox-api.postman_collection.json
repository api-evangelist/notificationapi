              "body": "{\n  \"notifications\": [\n    {\n      \"trackingId\": \"string\",\n      \"title\": \"string\",\n      \"url\": \"string\",\n      \"image\": \"string\",\n      \"date\": \"2022-09-30T21:19:37.733Z\",\n      \"opened\": \"1967-01-29T21:10:59.934Z\",\n      \"clicked\": \"1983-06-23T10:35:16.775Z\",\n      \"archived\": \"1959-10-08T15:50:03.698Z\"\n    },\n    {\n      \"trackingId\": \"string\",\n      \"title\": \"string\",\n      \"url\": \"string\",\n      \"image\": \"string\",\n      \"date\": \"1966-09-10T05:56:57.295Z\",\n      \"opened\": \"2013-04-14T02:22:54.958Z\",\n      \"clicked\": \"2001-10-27T22:25:00.058Z\",\n      \"archived\": \"2014-01-20T11:16:26.512Z\"\n    }\n  ],\n  \"oldestReceived\": \"1968-01-02T12:54:57.342Z\"\n}",
