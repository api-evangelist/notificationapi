          "name": "Send a notification",
          "request": {
            "name": "Send a notification",
            "description": {
              "content": "Sends a notification to the specified user across the channels configured for the notification type. Supply an ISO 8601 `schedule` value to schedule the notification for future delivery instead of sending immediately.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "sender"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [],
              "variable": [
                {
                  "description": "Your NotificationAPI account clientId.",
                  "type": "any",
                  "value": "{{clientId}}",
                  "key": "clientId"
                }
              ]
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "POST",
            "auth": null,
            "body": {
              "mode": "raw",
              "raw": "{\n  \"type\": \"<string>\",\n  \"to\": {\n    \"id\": \"<string>\",\n    \"email\": \"<string>\",\n    \"number\": \"<string>\",\n    \"timezone\": \"<string>\",\n    \"slackChannel\": \"<string>\",\n    \"pushTokens\": [\n      {\n        \"type\": \"<string>\",\n        \"token\": \"<string>\",\n        \"device\": {\n          \"device_id\": \"<string>\",\n          \"platform\": \"<string>\",\n          \"app_id\": \"<string>\"\n        }\n      },\n      {\n        \"type\": \"<string>\",\n        \"token\": \"<string>\",\n        \"device\": {\n          \"device_id\": \"<string>\",\n          \"platform\": \"<string>\",\n          \"app_id\": \"<string>\"\n        }\n      }\n    ],\n    \"webPushTokens\": [\n      \"<object>\",\n      \"<object>\"\n    ],\n    \"createdAt\": \"<dateTime>\",\n    \"updatedAt\": \"<dateTime>\"\n  },\n  \"parameters\": {\n    \"key_0\": \"string\",\n    \"key_1\": 4763,\n    \"key_2\": false\n  },\n  \"forceChannels\": [\n    \"<string>\",\n    \"<string>\"\n  ],\n  \"templateId\": \"<string>\",\n  \"subNotificationId\": \"<string>\",\n  \"schedule\": \"<dateTime>\",\n  \"email\": {\n    \"subject\": \"<string>\",\n    \"html\": \"<string>\",\n    \"previewText\": \"<string>\",\n    \"senderName\": \"<string>\",\n    \"senderEmail\": \"<string>\"\n  },\n  \"sms\": {\n    \"message\": \"<string>\"\n  },\n  \"call\": {\n    \"message\": \"<string>\"\n  },\n  \"inapp\": {\n    \"title\": \"<string>\",\n    \"url\": \"<string>\",\n    \"image\": \"<string>\"\n  },\n  \"web_push\": {\n    \"title\": \"<string>\",\n    \"message\": \"<string>\",\n    \"icon\": \"<string>\",\n    \"url\": \"<string>\"\n  },\n  \"mobile_push\": {\n    \"title\": \"<string>\",\n    \"message\": \"<string>\"\n  },\n  \"options\": \"<object>\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": [
            {
              "id": "49930ae0-0060-4402-815e-404899b4c38f",
              "name": "Notification accepted for delivery.",
              "originalRequest": {
